#!/usr/bin/env python3
"""
Cogman CLI
The interface to the AI Assistant.
"""
import sys
import argparse
import os

# Add parent dir to path
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from src.ai import CogmanBrain

def main():
    parser = argparse.ArgumentParser(description="Cogman: The Linux AI Assistant")
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # ask command
    parser_ask = subparsers.add_parser("ask", help="Ask Cogman a question")
    parser_ask.add_argument("query", nargs="+", help="The question to ask")

    args = parser.parse_args()

    if args.command == "ask":
        query = " ".join(args.query)
        brain = CogmanBrain()
        response = brain.ask(query)
        print(response)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
