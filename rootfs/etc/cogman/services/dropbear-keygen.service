[service]
name    = dropbear-keygen
command = /bin/sh -c 'mkdir -p /etc/dropbear && [ -f /etc/dropbear/dropbear_rsa_host_key ] || /usr/bin/dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key && [ -f /etc/dropbear/dropbear_ecdsa_host_key ] || /usr/bin/dropbearkey -t ecdsa -f /etc/dropbear/dropbear_ecdsa_host_key'
type    = oneshot
restart = never
depends = rcs
