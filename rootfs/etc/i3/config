# Rogue Linux i3 configuration
set $mod Mod4

# Font
font pango:monospace 11

# Window border
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Gaps
gaps inner 6
gaps outer 3

# Colors - dark theme
set $bg      #1e1e2e
set $fg      #cdd6f4
set $accent  #89b4fa
set $urgent  #f38ba8
set $border  #313244

client.focused          $accent  $bg     $fg $accent $accent
client.unfocused        $border  $bg     $fg $border $border
client.urgent           $urgent  $bg     $fg $urgent $urgent

# Key bindings
bindsym $mod+Return exec /usr/bin/alacritty
bindsym $mod+d      exec /usr/bin/dmenu_run
bindsym $mod+q      kill
bindsym $mod+l      exec /usr/bin/rogue-lock
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit?' -B 'Yes, exit i3' 'i3-msg exit'"

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

# Layout
bindsym $mod+e       layout toggle split
bindsym $mod+f       fullscreen toggle
bindsym $mod+space   floating toggle
bindsym $mod+r       mode "resize"

mode "resize" {
  bindsym h resize shrink width  10 px or 10 ppt
  bindsym j resize grow   height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow   width  10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}

# Status bar
bar {
  status_command  i3status 2>/dev/null || while true; do date '+%Y-%m-%d %H:%M:%S'; sleep 1; done
  position        bottom
  font            pango:monospace 10

  colors {
    background $bg
    statusline $fg
    separator  $border
    focused_workspace  $accent $accent $bg
    inactive_workspace $border $border $fg
    urgent_workspace   $urgent $urgent $fg
  }
}

# Startup
exec_always --no-startup-id /usr/bin/xsetroot -solid "#1e1e2e"
exec_always --no-startup-id /usr/bin/dunst
exec --no-startup-id /usr/bin/xss-lock --transfer-sleep-lock -- /usr/bin/rogue-lock &
exec /usr/bin/alacritty
