#!/bin/sh
# Rogue Linux system initialization — runs on every boot path.

# Re-mount virtual filesystems in case /init didn't already do so
# (idempotent: already-mounted mounts are skipped silently).
mount -t proc     proc     /proc    2>/dev/null || true
mount -t sysfs    sysfs    /sys     2>/dev/null || true
mount -t devtmpfs devtmpfs /dev     2>/dev/null || mdev -s
mkdir -p /dev/pts /dev/shm
mount -t devpts   devpts   /dev/pts 2>/dev/null || true
mount -t tmpfs    shm      /dev/shm 2>/dev/null || true
chmod 1777 /dev/shm

# Mount /tmp as tmpfs only if not already a tmpfs.
mountpoint -q /tmp 2>/dev/null || mount -t tmpfs tmpfs /tmp
chmod 1777 /tmp

# /run is pre-mounted as tmpfs by /init before cogman-supervisor starts,
# so the socket is already in place.  Just ensure the subdirs exist.
mkdir -p /run/cogman /run/lock
touch /run/utmp    2>/dev/null || true
chmod 664 /run/utmp 2>/dev/null || true

# Loopback
ip link set lo up 2>/dev/null || true

hostname rogue
echo "Rogue Linux 1.0 — booted OK"

# X11 socket directories (required before Xorg starts)
install -d -m 1777 /tmp/.X11-unix
install -d -m 1777 /tmp/.ICE-unix

# XDG runtime dir for void user
install -d -m 0700 -o 1000 /tmp/xdg-void 2>/dev/null || install -d -m 0700 /tmp/xdg-void

ldconfig -q 2>/dev/null || true
